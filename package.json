{
  "name": "gold-work-studio",
  "version": "0.2.6",
  "private": true,
  "description": "Portable Windows studio for AI-assisted video production",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --filter @gold-work/desktop dev",
    "build": "pnpm --filter @gold-work/desktop... --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "portable": "pnpm build && pnpm --filter @gold-work/desktop portable",
    "installer": "pnpm build && pnpm --filter @gold-work/desktop installer",
    "release:updates": "pnpm build && pnpm --filter @gold-work/desktop release:updates",
    "test:updates:installed": "node apps/desktop/scripts/update-install-check.mjs",
    "test:updates:github": "node apps/desktop/scripts/update-github-check.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
